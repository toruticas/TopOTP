{
  "name": "topotp",
  "version": "0.0.1",
  "private": true,
  "description": "Autenticador TOTP/HOTP para a barra de menus do macOS",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "build": "vue-tsc --noEmit && vite build",
    "tauri:build": "node scripts/build-local.mjs",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:interop": "cargo test --manifest-path src-tauri/Cargo.toml --test authenticator_interop",
    "check:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "probe:keychain": "python3 scripts/native-keychain-probe.py",
    "bindings": "cargo run --manifest-path src-tauri/Cargo.toml --features codegen --bin generate-bindings",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "test:e2e:build": "tauri build --debug --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json -- --target-dir ../.artifacts/e2e-target",
    "test:e2e": "npm run test:e2e:build && wdio run ./wdio.conf.mjs",
    "licenses": "python3 scripts/collect-licenses.py"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "@wdio/cli": "9.32.0",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/tauri-service": "1.5.0",
    "argon2": "0.45.1",
    "crypto-js": "4.2.0",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.13",
    "@wdio/globals": "9.31.3",
    "webdriverio": "9.32.0"
  },
  "overrides": {
    "basic-ftp": "6.2.3",
    "@wdio/globals": "$@wdio/globals",
    "webdriverio": "$webdriverio",
    "serialize-javascript": "7.1.2"
  }
}
