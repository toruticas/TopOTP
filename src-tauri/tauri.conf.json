{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TopOTP",
  "version": "0.0.1-beta.1",
  "identifier": "com.rafaelmariano.topotp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "panel",
        "title": "TopOTP",
        "width": 380,
        "height": 480,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "devtools": false,
        "create": false
      }
    ],
    "security": {
      "capabilities": ["panel"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/512x512.png"],
    "targets": ["app"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "signingIdentity": "-"
    },
    "resources": {
      "../LICENSE": "LICENSE",
      "resources/THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt"
    }
  }
}
