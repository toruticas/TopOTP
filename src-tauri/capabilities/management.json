{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "management",
  "description": "Only the local TopOTP management window can access presentation commands",
  "windows": ["management"],
  "platforms": ["macOS"],
  "permissions": [
    "allow-vault-status",
    "allow-unlock-vault",
    "allow-lock-vault",
    "allow-hide-panel",
    "allow-user-interaction",
    "allow-list-accounts",
    "allow-get-totp-codes",
    "allow-save-account",
    "allow-preview-uri-account",
    "allow-delete-account",
    "allow-generate-hotp",
    "allow-copy-code",
    "allow-set-account-order",
    "allow-begin-import",
    "allow-provide-import-passwords",
    "allow-commit-import",
    "allow-cancel-import",
    "allow-export-accounts",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-management-ready",
    "allow-pending-preview"
  ]
}
